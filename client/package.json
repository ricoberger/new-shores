{
  "name": "new-shores-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:pg": "playwright test -c playwright.pg.config.ts",
    "gen:api": "openapi-typescript ../server/api/openapi.yaml -o src/api/schema.d.ts",
    "gen:palette": "node scripts/gen-palette.mjs",
    "gen:hud-icons": "node scripts/gen-hud-icons.mjs",
    "assets": "node scripts/assets.mjs",
    "shots": "node --experimental-strip-types --no-warnings=ExperimentalWarning e2e/tools/shots.ts"
  },
  "dependencies": {
    "@babylonjs/core": "^9.31.0",
    "@babylonjs/loaders": "^9.31.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lighthouse": "^13.5.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
