# Local overrides of the Compose stack (credentials); never commit.
deploy/.env

# Third-party model kits (CC0 KayKit packs from kaylousberg.itch.io; tens of MB of
# binaries and partly paid tiers). The asset build verifies them by checksum
# against assets/kits/MANIFEST.json; recipes and generated GLBs are committed.
assets/kits/*
!assets/kits/MANIFEST.json
!assets/kits/README.md
.DS_Store

# Python caches (asset build).
__pycache__/

# Local experiments and scratch notes (renders, exploration scripts).
.experiment/

# Local AI team notes (specifications, implementation notes).
.ai-team/
