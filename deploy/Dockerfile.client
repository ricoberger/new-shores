# syntax=docker/dockerfile:1
# Static client served by Caddy, which also reverse-proxies /api/ to the
# game servers (one origin: VITE_API_BASE is empty). Build context:
# repository root.

FROM node:22-alpine AS build
WORKDIR /src/client
COPY client/package.json client/package-lock.json ./
RUN npm ci
COPY client/ ./
ENV VITE_API_BASE=""
RUN npm run build

FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /src/client/dist /srv
