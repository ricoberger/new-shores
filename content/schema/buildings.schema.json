{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ricoberger/new-shores/content/schema/buildings.schema.json",
  "title": "Buildings",
  "description": "Buildings of a region (CONTENT §5, §9). Behaviour is attached through optional capability blocks: recipe, house, trading_post (the island's capacity, pier and first building, D-051), warehouse (an inland collector, D-051), road, service, shipyard, work_area, workforce, fields (a farm that needs fields, D-049, D-051 part 4) and field (a field placeable: a 1x1 crop tile or a pasture module); requires_deposit ties a producer to a deposit tile; water_tiles makes a water-edge building (D-051).",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "region",
      "tier",
      "footprint",
      "coastal",
      "requires_road",
      "cost",
      "upkeep_per_min",
      "pause_category"
    ],
    "properties": {
      "id": { "$ref": "#/$defs/id" },
      "name": { "type": "string", "minLength": 1 },
      "region": { "$ref": "#/$defs/id" },
      "tier": { "$ref": "#/$defs/id" },
      "footprint": {
        "description": "[width, height] in tiles at rotation 0.",
        "type": "array",
        "prefixItems": [
          { "type": "integer", "minimum": 1 },
          { "type": "integer", "minimum": 1 }
        ],
        "minItems": 2,
        "maxItems": 2
      },
      "coastal": { "type": "boolean" },
      "requires_road": { "type": "boolean" },
      "cost": { "$ref": "#/$defs/cost" },
      "requires_deposit": {
        "description": "Deposit kind one footprint tile must carry; the building may also stand on mountain tiles (MECHANICS §2, D-036 interim rule).",
        "$ref": "#/$defs/id"
      },
      "upkeep_per_min": { "type": "number", "minimum": 0 },
      "pause_category": {
        "enum": ["need_goods", "public", "intermediate", "food_basic", "never"]
      },
      "boat": {
        "description": "The water-edge producer works with a boat (fisher): the life layer rows it out from the model's boat anchor and back (display only, CONTENT §11). Needs water_tiles. Absent is false.",
        "type": "boolean"
      },
      "smoke": {
        "description": "The producer burns or cooks: its model carries chimney and smoke anchors and the life layer draws smoke (producers only, CONTENT §11). Absent is false.",
        "type": "boolean"
      },
      "recipe": {
        "type": "object",
        "additionalProperties": false,
        "required": ["inputs", "outputs", "cycle_seconds"],
        "properties": {
          "inputs": { "type": "array", "items": { "$ref": "#/$defs/recipe_input" } },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/good_amount" }
          },
          "cycle_seconds": { "type": "number", "exclusiveMinimum": 0 }
        }
      },
      "house": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tier"],
        "properties": {
          "tier": { "$ref": "#/$defs/id" }
        }
      },
      "water_tiles": {
        "description": "Water-edge footprint (MECHANICS §2, D-051): the first n front rows (at rotation 0 the top rows, smallest y) must lie on water tiles, the remaining rows on buildable land. Less than the footprint height.",
        "type": "integer",
        "minimum": 1
      },
      "trading_post": {
        "description": "The Trading Post (MECHANICS §5, D-051): one per island, placed only by founding; its level sets the island's capacity per good, a collector throughput and the berths of its pier.",
        "type": "object",
        "additionalProperties": false,
        "required": ["levels"],
        "properties": {
          "levels": {
            "description": "Levels in order. The first level is placed with the building cost and has no cost; every later level is reached by an upgrade and requires its cost.",
            "type": "array",
            "minItems": 1,
            "prefixItems": [
              {
                "$ref": "#/$defs/trading_post_level",
                "not": { "required": ["cost"] }
              }
            ],
            "items": {
              "$ref": "#/$defs/trading_post_level",
              "required": ["cost"]
            }
          }
        }
      },
      "warehouse": {
        "description": "An inland collector (MECHANICS §5, D-051): adds throughput for the producers assigned to it, never capacity.",
        "type": "object",
        "additionalProperties": false,
        "required": ["levels"],
        "properties": {
          "levels": {
            "description": "Levels in order. The first level is placed with the building cost and has no cost; every later level is reached by an upgrade and requires its cost.",
            "type": "array",
            "minItems": 1,
            "prefixItems": [
              {
                "$ref": "#/$defs/warehouse_level",
                "not": { "required": ["cost"] }
              }
            ],
            "items": {
              "$ref": "#/$defs/warehouse_level",
              "required": ["cost"]
            }
          }
        }
      },
      "road": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seconds_per_tile"],
        "properties": {
          "seconds_per_tile": { "type": "number", "minimum": 0 }
        }
      },
      "service": {
        "description": "A public building serving houses within its radius (building needs). Either one radius or levels (D-056, upgrade_building): the first level is placed with the building cost; every later level needs a cost and may need a tier unlocked.",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "radius": { "type": "integer", "minimum": 1 },
          "levels": {
            "type": "array",
            "minItems": 1,
            "prefixItems": [
              {
                "$ref": "#/$defs/service_level",
                "not": { "anyOf": [{ "required": ["cost"] }, { "required": ["tier"] }] }
              }
            ],
            "items": {
              "$ref": "#/$defs/service_level",
              "required": ["cost"]
            }
          }
        },
        "oneOf": [{ "required": ["radius"] }, { "required": ["levels"] }]
      },
      "shipyard": {
        "description": "Orders ships of the listed types, one at a time (MECHANICS §9.1).",
        "type": "object",
        "additionalProperties": false,
        "required": ["ships"],
        "properties": {
          "ships": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          }
        }
      },
      "workforce": {
        "description": "Workers a producer needs from the residents of a tier on the same island (D-035).",
        "type": "object",
        "additionalProperties": false,
        "required": ["tier", "amount"],
        "properties": {
          "tier": { "$ref": "#/$defs/id" },
          "amount": { "type": "integer", "minimum": 1 }
        }
      },
      "fields": {
        "description": "A farm that needs fields (D-049, D-051 part 4): its efficiency is min(1, active fields / required). Fields are placed from the farm's panel, next to the farm or one of its active fields (an adjacency chain), at most max.",
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "required", "max"],
        "properties": {
          "type": {
            "description": "The farm's one field type (field.type of the field building whose field.farm is this farm).",
            "$ref": "#/$defs/id"
          },
          "required": { "description": "Active fields for full efficiency.", "type": "integer", "minimum": 1 },
          "max": { "description": "Most fields the farm may own (at least required).", "type": "integer", "minimum": 1 }
        }
      },
      "field": {
        "description": "A field placeable (D-049, D-051 part 4): a 1x1 crop tile or a pasture module (3x3 and larger, D-054) of one farm type, placed from that farm's panel on matching terrain (and fertility), 4-edge adjacent to the farm or to one of its active fields.",
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "farm", "terrain"],
        "properties": {
          "type": { "$ref": "#/$defs/id" },
          "farm": {
            "description": "Building type of the farm this field belongs to (its fields.type is this type), or a list of farm types sharing the field (D-056 C4: the cattle pasture of the dairy and cattle farms).",
            "oneOf": [
              { "$ref": "#/$defs/id" },
              { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
            ]
          },
          "terrain": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/terrain" }
          },
          "fertility": {
            "description": "Island-wide fertility tag the field needs.",
            "$ref": "#/$defs/id"
          }
        }
      },
      "work_area": {
        "description": "Work radius. Without a fields block radius, terrain and required_tiles are required (implicit terrain rule, MECHANICS §2); with a fields block only fertility is allowed (D-051 part 4: no radius).",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "radius": { "type": "integer", "minimum": 1 },
          "terrain": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/terrain" }
          },
          "required_tiles": { "type": "integer", "minimum": 1 },
          "fertility": {
            "description": "Island-wide fertility tag the building needs (MECHANICS §2).",
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "allOf": [
      {
        "not": { "required": ["trading_post", "warehouse"] }
      },
      {
        "if": { "required": ["fields"] },
        "then": {
          "properties": {
            "work_area": {
              "not": {
                "anyOf": [{ "required": ["radius"] }, { "required": ["terrain"] }, { "required": ["required_tiles"] }]
              }
            }
          }
        },
        "else": {
          "properties": {
            "work_area": { "required": ["radius", "terrain", "required_tiles"] }
          }
        }
      },
      {
        "if": { "required": ["field"] },
        "then": {
          "properties": {
            "upkeep_per_min": { "const": 0 },
            "pause_category": { "const": "never" },
            "requires_road": { "const": false },
            "coastal": { "const": false }
          },
          "not": {
            "anyOf": [
              { "required": ["recipe"] },
              { "required": ["house"] },
              { "required": ["trading_post"] },
              { "required": ["warehouse"] },
              { "required": ["water_tiles"] },
              { "required": ["road"] },
              { "required": ["service"] },
              { "required": ["shipyard"] },
              { "required": ["workforce"] },
              { "required": ["work_area"] },
              { "required": ["requires_deposit"] },
              { "required": ["fields"] }
            ]
          }
        }
      }
    ]
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "terrain": { "enum": ["water", "coast", "grass", "forest", "mountain"] },
    "trading_post_level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capacity", "throughput_per_min", "berths"],
      "properties": {
        "capacity": { "type": "number", "exclusiveMinimum": 0 },
        "throughput_per_min": { "type": "number", "exclusiveMinimum": 0 },
        "berths": {
          "description": "Ships that can load or unload at the pier at the same time (MECHANICS §9.3).",
          "type": "integer",
          "minimum": 1
        },
        "cost": {
          "description": "Upgrade cost into this level (gold from the world, materials from the island).",
          "$ref": "#/$defs/cost"
        }
      }
    },
    "warehouse_level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["throughput_per_min"],
      "properties": {
        "throughput_per_min": { "type": "number", "exclusiveMinimum": 0 },
        "cost": {
          "description": "Upgrade cost into this level (gold from the world, materials from the island).",
          "$ref": "#/$defs/cost"
        }
      }
    },
    "service_level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["radius"],
      "properties": {
        "radius": { "type": "integer", "minimum": 1 },
        "tier": {
          "description": "Tier that must be unlocked to upgrade into this level.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "cost": {
          "description": "Upgrade cost into this level (gold from the world, materials from the island).",
          "$ref": "#/$defs/cost"
        }
      }
    },
    "cost": {
      "description": "Construction cost: 'gold' plus materials by good ID (units).",
      "type": "object",
      "properties": {
        "gold": { "type": "number", "minimum": 0 }
      },
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "good_amount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["good", "amount"],
      "properties": {
        "good": { "$ref": "#/$defs/id" },
        "amount": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "recipe_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["good", "amount"],
      "description": "One input slot: a good, or a list of accepted goods in preference order (D-056: [\"charcoal\", \"coal\"]).",
      "properties": {
        "good": {
          "oneOf": [
            { "$ref": "#/$defs/id" },
            { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
          ]
        },
        "amount": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
