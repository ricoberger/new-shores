{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ricoberger/new-shores/content/schema/buildings.schema.json",
  "title": "Buildings",
  "description": "Buildings of a region (CONTENT §5, §9). Behaviour is attached through optional capability blocks: recipe, house, warehouse, road, service, shipyard, work_area, workforce, fields (a farm that needs explicit fields, D-049) and field (a 1x1 field placeable); requires_deposit ties a producer to a deposit tile.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "region",
      "tier",
      "footprint",
      "coastal",
      "requires_road",
      "cost",
      "upkeep_per_min",
      "pause_category"
    ],
    "properties": {
      "id": { "$ref": "#/$defs/id" },
      "name": { "type": "string", "minLength": 1 },
      "region": { "$ref": "#/$defs/id" },
      "tier": { "$ref": "#/$defs/id" },
      "footprint": {
        "description": "[width, height] in tiles at rotation 0.",
        "type": "array",
        "prefixItems": [
          { "type": "integer", "minimum": 1 },
          { "type": "integer", "minimum": 1 }
        ],
        "minItems": 2,
        "maxItems": 2
      },
      "coastal": { "type": "boolean" },
      "requires_road": { "type": "boolean" },
      "cost": { "$ref": "#/$defs/cost" },
      "requires_deposit": {
        "description": "Deposit kind one footprint tile must carry; the building may also stand on mountain tiles (MECHANICS §2, D-036 interim rule).",
        "$ref": "#/$defs/id"
      },
      "upkeep_per_min": { "type": "number", "minimum": 0 },
      "pause_category": {
        "enum": ["need_goods", "public", "intermediate", "food_basic", "never"]
      },
      "recipe": {
        "type": "object",
        "additionalProperties": false,
        "required": ["inputs", "outputs", "cycle_seconds"],
        "properties": {
          "inputs": { "type": "array", "items": { "$ref": "#/$defs/good_amount" } },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/good_amount" }
          },
          "cycle_seconds": { "type": "number", "exclusiveMinimum": 0 }
        }
      },
      "house": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tier"],
        "properties": {
          "tier": { "$ref": "#/$defs/id" }
        }
      },
      "warehouse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["levels"],
        "properties": {
          "levels": {
            "description": "Levels in order. The first level is placed with the building cost and has no cost; every later level is reached by an upgrade and requires its cost.",
            "type": "array",
            "minItems": 1,
            "prefixItems": [
              {
                "$ref": "#/$defs/warehouse_level",
                "not": { "required": ["cost"] }
              }
            ],
            "items": {
              "$ref": "#/$defs/warehouse_level",
              "required": ["cost"]
            }
          }
        }
      },
      "road": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seconds_per_tile"],
        "properties": {
          "seconds_per_tile": { "type": "number", "minimum": 0 }
        }
      },
      "service": {
        "type": "object",
        "additionalProperties": false,
        "required": ["radius"],
        "properties": {
          "radius": { "type": "integer", "minimum": 1 }
        }
      },
      "shipyard": {
        "description": "Orders ships of the listed types, one at a time (MECHANICS §9.1).",
        "type": "object",
        "additionalProperties": false,
        "required": ["ships"],
        "properties": {
          "ships": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          }
        }
      },
      "workforce": {
        "description": "Workers a producer needs from the residents of a tier on the same island (D-035).",
        "type": "object",
        "additionalProperties": false,
        "required": ["tier", "amount"],
        "properties": {
          "tier": { "$ref": "#/$defs/id" },
          "amount": { "type": "integer", "minimum": 1 }
        }
      },
      "fields": {
        "description": "A farm that needs explicit fields (D-049): its efficiency is min(1, assigned fields / required). Fields of the type are assigned to the nearest accepting farm whose work_area.radius contains them.",
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "required"],
        "properties": {
          "type": {
            "description": "Field type (field.type of a field building) the farm accepts.",
            "$ref": "#/$defs/id"
          },
          "required": { "type": "integer", "minimum": 1 }
        }
      },
      "field": {
        "description": "A 1x1 field placeable of a field type (D-049): placed on matching terrain (and fertility) inside the work radius of a farm that accepts the type.",
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "terrain"],
        "properties": {
          "type": { "$ref": "#/$defs/id" },
          "terrain": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/terrain" }
          },
          "fertility": {
            "description": "Island-wide fertility tag the field needs.",
            "$ref": "#/$defs/id"
          }
        }
      },
      "work_area": {
        "description": "Work radius. Without a fields block terrain and required_tiles are required (implicit terrain rule, MECHANICS §2); with a fields block they are forbidden (the radius bounds the fields).",
        "type": "object",
        "additionalProperties": false,
        "required": ["radius"],
        "properties": {
          "radius": { "type": "integer", "minimum": 1 },
          "terrain": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/terrain" }
          },
          "required_tiles": { "type": "integer", "minimum": 1 },
          "fertility": {
            "description": "Island-wide fertility tag the building needs (MECHANICS §2).",
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "allOf": [
      {
        "if": { "required": ["fields"] },
        "then": {
          "required": ["work_area"],
          "properties": {
            "work_area": {
              "not": {
                "anyOf": [{ "required": ["terrain"] }, { "required": ["required_tiles"] }]
              }
            }
          }
        },
        "else": {
          "properties": {
            "work_area": { "required": ["terrain", "required_tiles"] }
          }
        }
      },
      {
        "if": { "required": ["field"] },
        "then": {
          "properties": {
            "footprint": { "const": [1, 1] },
            "upkeep_per_min": { "const": 0 },
            "pause_category": { "const": "never" },
            "requires_road": { "const": false },
            "coastal": { "const": false }
          },
          "not": {
            "anyOf": [
              { "required": ["recipe"] },
              { "required": ["house"] },
              { "required": ["warehouse"] },
              { "required": ["road"] },
              { "required": ["service"] },
              { "required": ["shipyard"] },
              { "required": ["workforce"] },
              { "required": ["work_area"] },
              { "required": ["requires_deposit"] },
              { "required": ["fields"] }
            ]
          }
        }
      }
    ]
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "terrain": { "enum": ["water", "coast", "grass", "forest", "mountain"] },
    "warehouse_level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capacity", "throughput_per_min"],
      "properties": {
        "capacity": { "type": "number", "exclusiveMinimum": 0 },
        "throughput_per_min": { "type": "number", "exclusiveMinimum": 0 },
        "cost": {
          "description": "Upgrade cost into this level (gold from the world, materials from the island).",
          "$ref": "#/$defs/cost"
        }
      }
    },
    "cost": {
      "description": "Construction cost: 'gold' plus materials by good ID (units).",
      "type": "object",
      "properties": {
        "gold": { "type": "number", "minimum": 0 }
      },
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "good_amount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["good", "amount"],
      "properties": {
        "good": { "$ref": "#/$defs/id" },
        "amount": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
